# .claudeignore — что Claude Code не должен читать в проекте «Расчёт для инвестора»

# --- Данные и архивы (никогда не содержат кода) ---
# Репозиторий данных, если он склонирован рядом с сайтом
investor-data/
data/
# Отчёты маркетплейсов — тяжёлые Excel-файлы
reports/
*.xlsx
*.xls
*.csv
*.ods

# --- Зашифрованное подключение инвестора ---
# Содержимое — шифрованный блоб, читать бессмысленно; редактируется только через сайт
access.json

# --- Служебные папки Git и GitHub ---
.git/
.github/

# --- Библиотеки и зависимости (если появятся) ---
node_modules/
vendor/

# --- Картинки, иконки, шрифты ---
img/
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.ico
*.webp
*.woff
*.woff2
*.ttf
*.eot

# --- Резервные копии и временные файлы ---
backup/
backups/
*.bak
*.backup
*.tmp
*~

# --- Системные файлы ---
.DS_Store
Thumbs.db
desktop.ini
